# Copy to .env.local for local development. Every value below has a working
# default, so the app runs with no .env file at all.

# Where the SQLite database file lives. Relative paths resolve from the repo root.
# On a platform with a mounted volume, point this at the volume (e.g. /data/app.db).
DATABASE_PATH=./data/app.db

# HMAC key used to sign the session cookie.
# A random dev key is generated automatically if this is unset, but sessions then
# reset on every server restart. ALWAYS set this in production.
SESSION_SECRET=change-me-to-a-long-random-string
